{
  "name": "impresora-etiquetas",
  "version": "0.1.0",
  "private": true,
  "description": "Impresión de etiquetas de paciente en Zebra GK420t desde el mostrador",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "etiqueta:previa": "node --env-file-if-exists=.env --import tsx src/scripts/vistaPrevia.ts",
    "etiqueta:prueba": "node --env-file-if-exists=.env --import tsx src/scripts/imprimirPrueba.ts",
    "impresora": "node --env-file-if-exists=.env --import tsx src/scripts/impresora.ts",
    "logo": "node --env-file-if-exists=.env --import tsx src/scripts/logo.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "mssql": "^12.7.2",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
