# --- Servidor ---
PUERTO=3000
HOST=0.0.0.0

# --- Origen de datos de agenda ---
# mock  = datos ficticios, para desarrollo sin acceso a PRIME
# prime = base de datos real de Green Cube
ORIGEN_DATOS=mock

# Conexión a PRIME (solo si ORIGEN_DATOS=prime).
# Requiere un login de SQL Server de SOLO LECTURA: la aplicación nunca escribe
# en PRIME. Permisos necesarios: SELECT sobre PatientManagement..Appointments,
# ..Schedules, ..Customer y Configuration..agreement, ..insurance, ..Provinces.
PRIME_HOST=10.0.0.16
PRIME_PUERTO=62314
PRIME_BASE=PatientManagement
PRIME_USUARIO=
PRIME_PASSWORD=

# --- Impresoras ---
# JSON en una sola línea. Si se deja vacío se usa config/impresoras.json,
# que es lo cómodo en desarrollo. En el NAS se usa esta variable porque el
# contenedor no corre como root y no puede leer ficheros montados del QNAP.
# IMPRESORAS=[{"id":"extracciones","nombre":"Mostrador de Extracciones","host":"10.0.1.141","puerto":9100,"modelo":"Zebra GK420t","predeterminada":true}]

# --- Etiqueta ---
# directa = papel térmico sin ribbon (^MTD)
# transferencia = con ribbon (^MTT)
ETIQUETA_METODO=directa

# Dimensiones en milímetros del cuerpo de la etiqueta
ETIQUETA_ANCHO_MM=100
ETIQUETA_ALTO_MM=35

# Margen interior. Subirlo si el contenido se sale por los bordes,
# bajarlo si sobra demasiado papel en blanco.
ETIQUETA_MARGEN_MM=2.5

# Logo del hospital. Se carga una vez en la impresora con `npm run logo`,
# que al terminar indica los valores exactos de ancho y alto a poner aquí.
# Dejar ETIQUETA_LOGO vacío para imprimir sin logo.
ETIQUETA_LOGO=
ETIQUETA_LOGO_ANCHO_PT=0
ETIQUETA_LOGO_ALTO_PT=0

# Contraste (0-30) y velocidad (1-6, en pulgadas/s).
# Vacío = respetar lo que tenga configurado la impresora.
ETIQUETA_CONTRASTE=
ETIQUETA_VELOCIDAD=4

# Copias por defecto que propone la interfaz
COPIAS_POR_DEFECTO=3
# El paciente sin cita suele venir a una batería de pruebas y necesita una
# pegatina por tubo, de ahí que se le propongan bastantes más.
COPIAS_PACIENTE_SUELTO=12
COPIAS_MAXIMAS=30

# --- Datos propios ---
# Registro de impresiones y vistas guardadas. En PRIME no se escribe nunca.
BASE_DATOS=datos/etiquetas.db

# Cada cuántos segundos refresca la agenda el navegador, para que aparezcan
# las citas que se acaban de dar de alta.
REFRESCO_SEGUNDOS=25
